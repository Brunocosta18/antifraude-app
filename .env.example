# Configurações do Servidor
PORT=3000
# 127.0.0.1 = acessível só nesta máquina. Use 0.0.0.0 para testar pelo celular na mesma rede.
HOST=127.0.0.1
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Configurações de Segurança
# Lista de origens separadas por vírgula (ex: http://localhost:8081,https://app.exemplo.com.br).
# "*" libera qualquer origem e só é aceito fora de produção (o servidor não sobe com "*" em production).
CORS_ORIGIN=*

# APIs de Inteligência de Ameaças (Free Tiers/Open)
# Adicione chaves apenas de serviços que possuem plano gratuito sem cartão
PHISHTANK_API_KEY=

# URLhaus (abuse.ch) — chave gratuita, sem cartão: https://auth.abuse.ch/
# Vazio = feed desligado (a análise segue só com as regras locais). Só o hostname é enviado.
URLHAUS_AUTH_KEY=
# Prazo total da consulta externa por análise, em ms (100 a 2000)
THREAT_FEED_TIMEOUT_MS=2000

# Limite de requisições por IP em POST /api/v1/analyze (contadores só em memória)
# Máximo de requisições por janela (1 a 10000) e tamanho da janela em ms (1000 a 3600000)
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
